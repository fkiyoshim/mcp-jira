      "type": "string"
    },
    "folder": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "required": true
    },
    "priority": {
      "type": "string",
      "required": true
    },
    "component": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
